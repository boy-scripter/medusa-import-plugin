{
  "name": "@xross-dev/medusa-product-import",
  "version": "1.0.2",
  "description": "Resilient CSV product import for Medusa v2: Admin UI, DB checkpoints, workflow retries, Continue Job",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "keywords": [
    "medusa",
    "plugin",
    "medusa-v2",
    "medusa-plugin-admin",
    "medusa-plugin-other"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "medusa plugin:build",
    "db:generate": "medusa plugin:db:generate",
    "test:unit": "TEST_TYPE=unit jest --runInBand",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.8.0",
    "@medusajs/cli": "^2.8.0",
    "@medusajs/framework": "^2.8.0",
    "@medusajs/icons": "^2.8.0",
    "@medusajs/medusa": "^2.8.0",
    "@medusajs/test-utils": "^2.8.0",
    "@medusajs/ui": "^4.0.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@tanstack/react-query": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.8.0",
    "@medusajs/framework": "^2.8.0",
    "@medusajs/icons": "^2.8.0",
    "@medusajs/medusa": "^2.8.0",
    "@medusajs/ui": "^4.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
