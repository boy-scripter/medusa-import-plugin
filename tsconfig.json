{
  "compilerOptions": {
    "target": "ES2021", "esModuleInterop": true, "module": "Node16", "moduleResolution": "Node16",
    "emitDecoratorMetadata": true, "experimentalDecorators": true, "declaration": false,
    "sourceMap": false, "outDir": "./.medusa/server", "rootDir": ".", "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true, "resolveJsonModule": true, "checkJs": false,
    "strictNullChecks": true, "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", ".medusa/server", ".medusa/admin", ".cache"]
}
